node_modules/
.ai-memory
# Runs, demos and the venv are made here and are nobody else's business.
artifacts/*
# The game, the mod and the maps are. They are kept so a build needs no
# network and every build gets the same bytes.
!artifacts/headless-sim/
!artifacts/mods/
!artifacts/maps/
# And what `npm run weapons` measures about the mod's weapons: the policy's
# ballistics and weapon features come from here, and a build without the file
# trains blind. Committed so a fresh clone and the image both have it.
!artifacts/weapons.*.json
*.log

# Python leaves these beside the trainer; they are not source.
__pycache__/
*.pyc
