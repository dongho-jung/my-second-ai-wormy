# The venv is built inside the image — a laptop's is the wrong architecture —
# and a laptop's runs are not this run's. The game, the mod and the maps do
# come from here: they are in the repository so a build needs no network.
artifacts/*
!artifacts/headless-sim
!artifacts/mods
!artifacts/maps
node_modules/
.git/
.ai-memory
*.log
__pycache__/
*.pyc
# The watching half's own dashboard, its tests and its prose. The two pages
# that ARE served here — public/train and public/watch — stay.
public/app.js
public/index.html
public/style.css
test/
docs/
